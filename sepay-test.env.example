# SePay Test credentials for the phase-03 verification probe (tools/sepay_probe).
# Copy to $HOME/.config/payment-module/sepay-test.env (chmod 600) and fill in.
# Never commit the filled file and never paste these values into chat or orca messages.

# Must be exactly "test"; the probe refuses to run otherwise (Live is forbidden).
SEPAY_ENVIRONMENT=test

# SePay Test API token (company-level) used for GET https://userapi.sepay.vn/v2/transactions.
SEPAY_TEST_API_TOKEN=

# Secret configured on the SePay Test webhook (HMAC of "{timestamp}.{raw_body}").
SEPAY_TEST_WEBHOOK_SECRET=
